{
  "server": {
    "port": 3457,
    "host": "127.0.0.1"
  },
  "logging": {
    "enabled": true,
    "level": "verbose",
    "dir": "./logs"
  },
  "providers": [
    {
      "name": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1/chat/completions",
      "apiKey": "your-openrouter-key-here",
      "format": "openai",
      "models": {
        "anthropic/claude-sonnet-4": {
          "temperature": 0.7,
          "max_tokens": 4096
        }
      },
      "info": {
        "anthropic/claude-sonnet-4": {
          "contextRange": "200K",
          "weeklyLimit": {
            "maxTotalTokens": 1000000,
            "enabled": true
          }
        }
      }
    },
    {
      "name": "zp",
      "baseUrl": "https://api.z.ai/api/anthropic/v1/messages",
      "apiKey": "your-zpai-key-here",
      "format": "anthropic",
      "models": {
        "glm-4.7": {
          "temperature": 0.7,
          "max_tokens": 8192
        },
        "glm-5": {
          "temperature": 0.5
        }
      },
      "info": {
        "glm-4.7": {
          "contextRange": "128K",
          "weeklyLimit": {
            "maxInputTokens": 500000,
            "maxOutputTokens": 200000,
            "enabled": true
          }
        },
        "glm-5": {
          "contextRange": "200K"
        }
      }
    },
    {
      "name": "anthropic-direct",
      "baseUrl": "https://api.anthropic.com/v1/messages",
      "apiKey": "your-anthropic-key-here",
      "format": "anthropic",
      "info": {
        "claude-opus-4-5-20251101": {
          "contextRange": "200K"
        }
      }
    }
  ],
  "router": {
    "haiku": "zp,glm-4.7-flashx",
    "sonnet": [
      "zp,glm-4.7",
      "openrouter,anthropic/claude-sonnet-4"
    ],
    "opus": {
      "targets": [
        { "provider": "zp", "model": "glm-4.7", "weight": 70 },
        { "provider": "anthropic-direct", "model": "claude-opus-4-5-20251101", "weight": 30 }
      ],
      "strategy": "weighted-round-robin"
    },
    "image": "zp,glm-4.7"
  },
  "statusline": {
    "enabled": true,
    "sessionRetentionHours": 24
  }
}
